<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_core_api_device_secret_wizard_form" model="ir.ui.view">
        <field name="name">core.api.device.secret.wizard.form</field>
        <field name="model">core.api.device.secret.wizard</field>
        <field name="arch" type="xml">
            <form string="Device Credentials">
                <group>
                    <div class="alert alert-warning" role="alert">
                        Copy these credentials now. The client secret will not be shown again.
                        Use the copy icon next to each field.
                    </div>
                    <field name="device_id" invisible="1"/>
                    <field name="client_id" string="Client ID" readonly="1" widget="CopyClipboardChar"/>
                    <field name="client_secret" string="Client Secret" readonly="1" widget="CopyClipboardChar"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Done" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
