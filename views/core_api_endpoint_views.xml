<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Read-only picker — no New / Edit from Gateway Routes -->
    <record id="view_ir_actions_server_core_api_picker_list" model="ir.ui.view">
        <field name="name">ir.actions.server.core.api.picker.list</field>
        <field name="model">ir.actions.server</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Server Actions" create="false" edit="false" delete="false" import="false">
                <field name="name"/>
                <field name="model_id"/>
                <field name="state"/>
                <field name="usage"/>
            </list>
        </field>
    </record>

    <record id="view_core_api_endpoint_list" model="ir.ui.view">
        <field name="name">core.api.endpoint.list</field>
        <field name="model">core.api.endpoint</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="route_pattern"/>
                <field name="http_methods"/>
                <field name="action_id" readonly="1"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_core_api_endpoint_form" model="ir.ui.view">
        <field name="name">core.api.endpoint.form</field>
        <field name="model">core.api.endpoint</field>
        <field name="arch" type="xml">
            <form string="Gateway Route">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Applications call <strong>Gateway Route</strong> on this Odoo server.
                        After auth, Odoo runs the linked <strong>Server Action</strong>
                        (any model). Use
                        <code>env['core.api.application'].set_api_response({...})</code>
                        in the action code to return JSON.
                        Server Actions are managed by developers under
                        <strong>Settings → Technical → Server Actions</strong> — here you only
                        <strong>select</strong> an existing action.
                    </div>
                    <group>
                        <group string="Gateway (public)">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="route_pattern" placeholder="/api/v1/orders"/>
                            <field name="http_methods" placeholder="GET,POST"/>
                            <field name="active"/>
                        </group>
                        <group string="Handler">
                            <field name="action_id"
                                   can_create="0"
                                   options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"
                                   context="{
                                       'create': False,
                                       'edit': False,
                                       'delete': False,
                                       'list_view_ref': 't4_coreapi.view_ir_actions_server_core_api_picker_list',
                                   }"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What this route is for…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_core_api_endpoint" model="ir.actions.act_window">
        <field name="name">Gateway Routes</field>
        <field name="res_model">core.api.endpoint</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
