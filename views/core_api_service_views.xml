<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- t4.coreapi.service views -->
    <record id="view_t4_coreapi_service_list" model="ir.ui.view">
        <field name="name">t4.coreapi.service.list</field>
        <field name="model">t4.coreapi.service</field>
        <field name="arch" type="xml">
            <list string="Core API Services">
                <field name="name"/>
                <field name="code"/>
                <field name="privacy"/>
            </list>
        </field>
    </record>

    <record id="view_t4_coreapi_service_form" model="ir.ui.view">
        <field name="name">t4.coreapi.service.form</field>
        <field name="model">t4.coreapi.service</field>
        <field name="arch" type="xml">
            <form string="Core API Service">
                <header>
                    <button name="action_generate_jwt_secret" type="object" string="Generate JWT Secret" invisible="privacy == 'public'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Information">
                            <field name="code"/>
                            <field name="privacy" widget="radio"/>
                        </group>
                        <group string="Security">
                            <field name="jwt_secret" invisible="1"/>
                            <field name="is_rate_limit_enabled" widget="boolean_toggle"/>
                            <field name="rate_limit_type" invisible="privacy == 'public' or not is_rate_limit_enabled" widget="radio"/>
                            <label for="rate_limit_calls" string="Limit (Calls/Period)" invisible="not is_rate_limit_enabled"/>
                            <div class="o_row" invisible="not is_rate_limit_enabled">
                                <field name="rate_limit_calls" class="oe_inline"/> / 
                                <field name="rate_limit_period" class="oe_inline"/> minute(s)
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Versions">
                            <field name="version_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="active" widget="boolean_toggle"/>
                                    <field name="total_routes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Required Actions">
                            <field name="required_action_ids">
                                <list editable="bottom">
                                    <field name="api_action_id"/>
                                    <field name="sequence"/>
                                </list>
                            </field>
                        </page>
                        <page string="API Users" invisible="privacy == 'public'">
                            <field name="client_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="username"/>
                                    <field name="password" password="True"/>
                                    <field name="role_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Roles" invisible="privacy == 'public'">
                            <field name="role_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="implied_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                        </page>
                        <page string="Instruction">
                            <field name="instruction" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_t4_coreapi_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">t4.coreapi.service</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
