<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_core_api_token_list" model="ir.ui.view">
        <field name="name">core.api.token.list</field>
        <field name="model">core.api.token</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="name"/>
                <field name="device_name"/>
                <field name="client_id"/>
                <field name="active"/>
                <field name="create_date"/>
                <field name="expiration_date"/>
                <field name="last_used_at"/>
                <field name="last_used_ip"/>
                <button name="action_revoke" type="object" string="Revoke"
                        invisible="not active"
                        groups="t4_coreapi.group_core_api_manager"/>
            </list>
        </field>
    </record>

    <record id="view_core_api_token_form" model="ir.ui.view">
        <field name="name">core.api.token.form</field>
        <field name="model">core.api.token</field>
        <field name="arch" type="xml">
            <form string="Access Token">
                <header>
                    <button name="action_revoke" type="object" string="Revoke Token"
                            class="btn-warning"
                            invisible="not active"
                            groups="t4_coreapi.group_core_api_manager"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="device_id"/>
                        <field name="client_id"/>
                        <field name="active"/>
                        <field name="expiration_date"/>
                        <field name="last_used_at"/>
                        <field name="last_used_ip"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_core_api_token" model="ir.actions.act_window">
        <field name="name">Access Tokens</field>
        <field name="res_model">core.api.token</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
