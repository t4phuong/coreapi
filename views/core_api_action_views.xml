<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- t4.coreapi.action views -->
    <record id="view_t4_coreapi_action_list" model="ir.ui.view">
        <field name="name">t4.coreapi.action.list</field>
        <field name="model">t4.coreapi.action</field>
        <field name="arch" type="xml">
            <list string="API Actions">
                <!-- <header>
                    <button name="%(t4_coreapi.action_t4_coreapi_action_generate_wizard)d" type="action" string="Generate Actions" display="always" context="{'default_service_id': context.get('default_service_id')}"/>
                    
                    <button name="action_generate_core_api_action"
                        string="Generate Actions"
                        type="object"
                        class="btn-primary"
                        display="always"
                        context="{'service_id': context.get('service_id')}"/>
                </header> -->
                <field name="name"/>
                <field name="model_id"/>
            </list>
        </field>
    </record>

    <record id="view_t4_coreapi_action_form" model="ir.ui.view">
        <field name="name">t4.coreapi.action.form</field>
        <field name="model">t4.coreapi.action</field>
        <field name="arch" type="xml">
            <form string="API Action">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="service_id"/>
                            <field name="model_id"/>
                            <field name="type" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Code">
                            <field name="code" widget="ace" options="{'mode': 'python'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_t4_coreapi_action" model="ir.actions.act_window">
        <field name="name">API Actions</field>
        <field name="res_model">t4.coreapi.action</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
