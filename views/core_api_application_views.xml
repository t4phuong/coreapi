<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_core_api_application_search" model="ir.ui.view">
        <field name="name">core.api.application.search</field>
        <field name="model">core.api.application</field>
        <field name="arch" type="xml">
            <search string="Applications">
                <field name="name"/>
                <field name="client_id"/>
                <field name="domain_id"/>
                <filter string="Active" name="filter_active" domain="[('state', '=', 'active')]"/>
                <filter string="Inactive" name="filter_inactive" domain="[('state', '=', 'inactive')]"/>
            </search>
        </field>
    </record>

    <record id="view_core_api_application_list" model="ir.ui.view">
        <field name="name">core.api.application.list</field>
        <field name="model">core.api.application</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="domain_id"/>
                <field name="client_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'inactive'"/>
                <field name="token_count"/>
                <field name="token_expiration"/>
                <field name="last_auth_at"/>
            </list>
        </field>
    </record>

    <record id="view_core_api_application_form" model="ir.ui.view">
        <field name="name">core.api.application.form</field>
        <field name="model">core.api.application</field>
        <field name="arch" type="xml">
            <form string="API Application">
                <header>
                    <button name="action_set_active" type="object"
                            string="Activate"
                            class="oe_highlight"
                            invisible="state == 'active'"
                            groups="t4_coreapi.group_core_api_manager"/>
                    <button name="action_set_inactive" type="object"
                            string="Deactivate"
                            invisible="state == 'inactive'"
                            groups="t4_coreapi.group_core_api_manager"/>
                    <button name="action_view_credentials" type="object"
                            string="View Credentials"
                            invisible="not credentials_pending"
                            groups="t4_coreapi.group_core_api_manager"/>
                    <button name="action_regenerate_secret" type="object"
                            string="Regenerate Secret"
                            invisible="not id"
                            groups="t4_coreapi.group_core_api_manager"/>
                    <button name="action_revoke_token" type="object"
                            string="Revoke Token"
                            class="btn-warning"
                            invisible="not active_token_id"
                            groups="t4_coreapi.group_core_api_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="active,inactive"
                           options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Inactive" bg_color="text-bg-danger"
                            invisible="state == 'active'"/>
                    <div class="alert alert-info" role="alert" invisible="id">
                        Client ID and Client Secret are generated automatically when you save.
                        A popup will appear so you can copy them once.
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tokens" type="object" class="oe_stat_button" icon="fa-key"
                                invisible="not id">
                            <field name="token_count" widget="statinfo" string="Tokens"/>
                        </button>
                        <button name="action_view_logs" type="object" class="oe_stat_button" icon="fa-list"
                                invisible="not id">
                            <field name="log_count" widget="statinfo" string="Logs"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="domain_id" options="{'no_create': True}"/>
                            <field name="default_version_id"
                                   domain="[('domain_id', '=', domain_id), ('active', '=', True)]"/>
                            <field name="client_id" readonly="1" invisible="not client_id"/>
                            <field name="token_ttl_hours"/>
                            <field name="refresh_token_ttl_hours"/>
                        </group>
                        <group string="Token Status">
                            <field name="active_token_id" readonly="1"/>
                            <field name="token_expiration"/>
                            <field name="last_auth_at"/>
                            <field name="last_auth_ip"/>
                            <field name="credentials_pending" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <field name="domain_version_count" invisible="1"/>
                        <page string="API Routes" name="gateway_routes_empty"
                              invisible="domain_version_count != 0">
                            <field name="version_tab_ids" invisible="1"/>
                            <div class="alert alert-warning mb-0" role="alert">
                                This host domain has no API versions.
                                Create versions on the <strong>Host Domain</strong> record.
                            </div>
                        </page>
                        <page string="All Routes" name="gateway_routes_all">
                            <field name="endpoint_ids" nolabel="1"
                                   context="{
                                       'default_application_id': id,
                                       'default_domain_id': domain_id,
                                       'default_version_id': default_version_id,
                                   }">
                                <list editable="bottom" default_group_by="version_id">
                                    <field name="application_id" column_invisible="1"/>
                                    <field name="version_id"
                                           domain="[('domain_id', '=', parent.domain_id), ('active', '=', True)]"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="route_suffix"/>
                                    <field name="route_pattern" readonly="1"/>
                                    <field name="http_methods"/>
                                    <field name="action_id"
                                           can_create="0"
                                           options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"
                                           context="{
                                               'list_view_ref': 't4_coreapi.view_ir_actions_server_core_api_picker_list',
                                           }"/>
                                    <field name="active"/>
                                </list>
                                <form string="Gateway Route">
                                    <field name="application_id" required="1" invisible="1"/>
                                    <group>
                                        <group string="Gateway (public)">
                                            <field name="version_id"
                                                   domain="[('domain_id', '=', parent.domain_id), ('active', '=', True)]"/>
                                            <field name="name"/>
                                            <field name="code"/>
                                            <field name="route_suffix" placeholder="orders"/>
                                            <field name="route_pattern" readonly="1"/>
                                            <field name="http_methods" placeholder="GET,POST"/>
                                            <field name="active"/>
                                        </group>
                                        <group string="Handler">
                                            <field name="action_id"
                                                   can_create="0"
                                                   options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"
                                                   context="{
                                                       'create': False,
                                                       'edit': False,
                                                       'delete': False,
                                                       'list_view_ref': 't4_coreapi.view_ir_actions_server_core_api_picker_list',
                                                   }"/>
                                        </group>
                                    </group>
                                    <field name="description" placeholder="What this route is for…"/>
                                </form>
                            </field>
                        </page>

                        <page string="Authentication Guide" name="auth_guide" invisible="not client_id">
                            <div class="alert alert-info mb-3" role="alert">
                                <strong>How to authenticate</strong>
                                <ol class="mb-0 mt-2">
                                    <li>Use your Odoo <strong>database name</strong> (shown below) via <code>?db=...</code> or the <code>X-Odoo-Database</code> header. This is not the module name.</li>
                                    <li>Request an access token with your <strong>Client ID</strong> and <strong>Client Secret</strong>.</li>
                                    <li>Call any allowed Gateway Route with <code>Authorization: Bearer &lt;access_token&gt;</code>.</li>
                                    <li>Reuse the token until it expires or is revoked.</li>
                                </ol>
                            </div>
                            <group>
                                <group string="Step 1: Get access token">
                                    <field name="api_database_name" readonly="1" widget="CopyClipboardChar"/>
                                    <field name="api_base_url" readonly="1"/>
                                    <field name="auth_endpoint_url" readonly="1" widget="CopyClipboardChar"/>
                                    <label for="auth_curl_example" string="Example request"/>
                                    <div class="o_row">
                                        <field name="auth_curl_example" readonly="1" nolabel="1" colspan="2"
                                               class="font-monospace text-muted"/>
                                    </div>
                                </group>
                                <group string="Step 2: Call a Gateway Route">
                                    <div colspan="2" class="text-muted">
                                        Replace <code>&lt;access_token&gt;</code> with the token from step 1.
                                        The sample URL uses your first configured route (or a placeholder).
                                    </div>
                                    <label for="api_call_curl_example" string="Example request"/>
                                    <div class="o_row">
                                        <field name="api_call_curl_example" readonly="1" nolabel="1" colspan="2"
                                               class="font-monospace text-muted"/>
                                    </div>
                                </group>
                            </group>
                            <group string="Token response (success)">
                                <div colspan="2" class="font-monospace text-muted">
                                    {<br/>
                                    &#160;&#160;"status": "success",<br/>
                                    &#160;&#160;"message": "Authentication successful.",<br/>
                                    &#160;&#160;"api_token": {<br/>
                                    &#160;&#160;&#160;&#160;"token": "…",<br/>
                                    &#160;&#160;&#160;&#160;"expires_in": 86400<br/>
                                    &#160;&#160;},<br/>
                                    &#160;&#160;"refresh_token": {<br/>
                                    &#160;&#160;&#160;&#160;"token": "…",<br/>
                                    &#160;&#160;&#160;&#160;"expires_in": 604800<br/>
                                    &#160;&#160;}<br/>
                                    }
                                </div>
                            </group>
                            <group string="Auth error examples">
                                <div colspan="2" class="font-monospace text-muted">
                                    {"status": "error", "message": "client_id is required."}<br/>
                                    {"status": "error", "message": "client_secret is required."}<br/>
                                    {"status": "error", "message": "No application found for the given client_id."}<br/>
                                    {"status": "error", "message": "Invalid client_secret for the given client_id."}<br/>
                                    {"status": "error", "message": "Application \"My App\" is inactive."}
                                </div>
                            </group>
                        </page>

                        <page string="Security" name="security">
                            <group>
                                <group>
                                    <field name="rate_limit_per_minute"/>
                                    <field name="auth_rate_limit_per_minute"/>
                                </group>
                                <group>
                                    <field name="allowed_ips" placeholder="203.0.113.10&#10;198.51.100.0/24"/>
                                </group>
                            </group>
                        </page>
                    </notebook>

                    <group>
                        <field name="notes" placeholder="Internal notes…" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_core_api_application" model="ir.actions.act_window">
        <field name="name">Applications</field>
        <field name="res_model">core.api.application</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>

</odoo>
