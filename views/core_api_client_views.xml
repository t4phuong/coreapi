<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Core API Client Views -->
    <record id="view_t4_coreapi_client_list" model="ir.ui.view">
        <field name="name">t4.coreapi.client.list</field>
        <field name="model">t4.coreapi.client</field>
        <field name="arch" type="xml">
            <list string="API Clients">
                <field name="name"/>
                <field name="username"/>
                <field name="service_id"/>
            </list>
        </field>
    </record>

    <record id="view_t4_coreapi_client_form" model="ir.ui.view">
        <field name="name">t4.coreapi.client.form</field>
        <field name="model">t4.coreapi.client</field>
        <field name="arch" type="xml">
            <form string="API Client">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Client Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="service_id"/>
                            <field name="username"/>
                            <field name="password" password="True"/>
                            <div colspan="2" class="text-muted" style="font-size: 15px; margin-top: -15px;">
                                <i class="fa fa-info-circle"/> Please copy and save this password. For security reasons, it will be hidden after saving and cannot be viewed again.
                            </div>
                        </group>
                        <group>
                            <field name="role_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_t4_coreapi_client" model="ir.actions.act_window">
        <field name="name">API Clients</field>
        <field name="res_model">t4.coreapi.client</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
