<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_t4_coreapi_version_form" model="ir.ui.view">
        <field name="name">t4.coreapi.version.form</field>
        <field name="model">t4.coreapi.version</field>
        <field name="arch" type="xml">
            <form string="Core API Version">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="service_id"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Routes">
                            <field name="route_ids">
                                <list editable="bottom">
                                    <field name="route_path"/>
                                    <field name="display_route" widget="CopyClipboardChar" optional="show"/>
                                    <field name="allow_method"/>
                                    <field name="role_id"/>
                                    <field name="api_action_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
