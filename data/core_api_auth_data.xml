<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Default Auth Service (Public) -->
        <record id="service_auth_default" model="t4.coreapi.service" forcecreate="0" context="{'no_auto_version': True}">
            <field name="name">Authentication Service</field>
            <field name="code">auth</field>
            <field name="privacy">public</field>
        </record>

        <!-- Default Auth Version -->
        <record id="version_auth_v1" model="t4.coreapi.version" forcecreate="0">
            <field name="name">v1</field>
            <field name="service_id" ref="service_auth_default"/>
        </record>

        <!-- Default Login Action -->
        <record id="action_t4_coreapi_default_login" model="t4.coreapi.action" forcecreate="0">
            <field name="name">Default Auth: Login</field>
            <field name="model_id" search="[('model', '=', 't4.coreapi.auth')]"/>
            <field name="service_id" ref="service_auth_default"/>
            <field name="code"><![CDATA[model.action_login()]]></field>
        </record>

        <!-- Default Login Route -->
        <record id="route_auth_login" model="t4.coreapi.route" forcecreate="0">
            <field name="version_id" ref="version_auth_v1"/>
            <field name="route_path">/login</field>
            <field name="allow_method">POST</field>
            <field name="api_action_id" ref="action_t4_coreapi_default_login"/>
        </record>

        <!-- Default Logout Action -->
        <record id="action_t4_coreapi_default_logout" model="t4.coreapi.action" forcecreate="0">
            <field name="name">Default Auth: Logout</field>
            <field name="model_id" search="[('model', '=', 't4.coreapi.auth')]"/>
            <field name="service_id" ref="service_auth_default"/>
            <field name="code"><![CDATA[model.action_logout(auth_info)]]></field>
        </record>

        <!-- Default Logout Route -->
        <record id="route_auth_logout" model="t4.coreapi.route" forcecreate="0">
            <field name="version_id" ref="version_auth_v1"/>
            <field name="route_path">/logout</field>
            <field name="allow_method">POST</field>
            <field name="api_action_id" ref="action_t4_coreapi_default_logout"/>
        </record>

        <!-- Default Rate Limit Action -->
        <record id="action_t4_coreapi_default_rate_limit" model="t4.coreapi.action" forcecreate="0">
            <field name="name">Default: Rate Limit</field>
            <field name="model_id" search="[('model', '=', 't4.coreapi.service')]"/>
            <field name="code"><![CDATA[model.check_rate_limit(auth_info)]]></field>
        </record>

        <!-- Default Auth Middleware Action -->
        <record id="action_t4_coreapi_default_auth_middleware" model="t4.coreapi.action" forcecreate="0">
            <field name="name">Default: Authenticate - Authorizer</field>
            <field name="model_id" search="[('model', '=', 't4.coreapi.auth')]"/>
            <field name="code"><![CDATA[model.action_auth_middleware()]]></field>
        </record>

        <!-- Default Rate Limit Injection to Service Authentication -->
        <record id="middleware_t4_coreapi_rate_limit_auth_service" model="t4.coreapi.middleware" forcecreate="0">
            <field name="service_id" ref="service_auth_default"/>
            <field name="api_action_id" ref="action_t4_coreapi_default_rate_limit"/>
            <field name="sequence">10</field>
        </record>
    </data>
</odoo>
